{
  "name": "flaregram",
  "version": "1.3.0",
  "description": "A lightweight Telegram bot framework for Cloudflare Workers",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityash4rma/flaregram.git"
  },
  "bugs": {
    "url": "https://github.com/adityash4rma/flaregram/issues"
  },
  "homepage": "https://github.com/adityash4rma/flaregram#readme",
  "keywords": [
    "telegram",
    "telegram-bot",
    "cloudflare-workers",
    "workers",
    "webhooks"
  ],
  "type": "module",
  "bin": {
    "flaregram": "src/cli/index.js"
  },
  "exports": {
    ".": "./src/flaregram/index.js",
    "./bot": "./src/flaregram/bot.js",
    "./client": "./src/flaregram/client.js",
    "./webhook": "./src/flaregram/webhook.js"
  },
  "files": [
    "src",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "deploy": "wrangler deploy",
    "start": "wrangler dev",
    "dev:telegram": "node ./src/cli/index.js dev",
    "test": "node --test --test-concurrency=1",
    "check": "npm test && wrangler deploy --dry-run",
    "flaregram": "node ./src/cli/index.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^5.0.4",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
